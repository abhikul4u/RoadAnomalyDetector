<?xml version="1.0" encoding="utf-8"?>
<!--
  ============================================================================
   Project : Road Anomaly Detection System (RADS)
   File    : strings.xml
   Centralized user-facing text for the app, grouped by screen. Keeping strings
   here (instead of hardcoded in code/layouts) enables localization and a single
   place to edit copy. Entries prefixed "fmt_" are format templates whose %1$.. /
   %2$.. placeholders are filled in at runtime via getString(...).
   Author  : Rutuja Kulkarni
  ============================================================================
-->
<resources>
    <!-- App display name (launcher label and titles). -->
    <string name="app_name">RADS Detector</string>

    <!-- Permission Activity -->
    <!-- Shown on launch explaining why the app needs each permission. -->
    <string name="permission_intro_message">This app needs Camera and Location access to detect road anomalies and tag them with GPS coordinates. Notifications are used for high-priority alerts.</string>
    <!-- Label of the button that triggers the permission requests. -->
    <string name="permission_grant">Grant permissions</string>
    <!-- Shown if the user denies; directs them to enable permissions manually. -->
    <string name="permission_denied_message">Permissions are required for the app to function. Please enable them in Settings.</string>
    <!-- Label of the button that opens the OS app-settings screen. -->
    <string name="permission_open_settings">Open Settings</string>

    <!-- Main Activity -->
    <!-- Error shown when the TFLite model asset is missing or fails to load. -->
    <string name="error_model_load">Failed to load model. Make sure model.tflite is in the assets folder.</string>
    <!-- Content description / label for the settings button. -->
    <string name="settings">Settings</string>
    <!-- HUD format: per-frame inference time in milliseconds. -->
    <string name="fmt_perf">Inference: %1$d ms</string>
    <!-- HUD format: active inference delegate name (e.g. GPU/CPU). -->
    <string name="fmt_delegate">Delegate: %1$s</string>
    <!-- HUD format: current latitude/longitude (4 decimal places each). -->
    <string name="fmt_gps">GPS: %1$.4f°, %2$.4f°</string>
    <!-- HUD format: number of detection reports queued locally. -->
    <string name="fmt_queue">Reports queued: %1$d</string>

    <!-- Settings Activity -->
    <!-- Section headers on the settings screen. -->
    <string name="settings_section_model">Model</string>
    <string name="settings_section_thresholds">Thresholds</string>
    <string name="settings_section_storage">Storage</string>
    <!-- Label of the button that deletes all stored reports. -->
    <string name="settings_clear_queue">Clear all reports</string>
    <!-- Settings format: model file name, input W×H, and class count. -->
    <string name="fmt_model_info">%1$s • %2$d×%3$d • %4$d classes</string>
    <!-- Settings format: confidence and IoU thresholds (2 decimals each). -->
    <string name="fmt_thresholds">Confidence: %1$.2f • IoU: %2$.2f</string>
    <!-- Settings format: count of reports currently stored. -->
    <string name="fmt_settings_queue">%1$d reports stored</string>

    <!-- Reports screen -->
    <!-- Button on the main screen that opens the Reports list. -->
    <string name="btn_view_reports">View Reports</string>
    <!-- Toolbar titles for the list and detail screens. -->
    <string name="title_reports">Reports</string>
    <string name="title_report_detail">Detection Report</string>
    <!-- Toolbar / button action labels. -->
    <string name="action_export_csv">Export CSV</string>
    <string name="action_clear_all">Clear all</string>
    <string name="action_share">Share</string>
    <string name="action_delete">Delete</string>
    <string name="action_open_in_maps">Open in Maps</string>
    <!-- Empty-state message shown when no reports have been stored yet. -->
    <string name="empty_state_no_reports">No reports yet. Start detecting to see them here.</string>
    <!-- Confirmation dialog copy. %d is the number of reports to be deleted. -->
    <string name="confirm_clear_all">Delete all %d reports? This cannot be undone.</string>
    <string name="confirm_delete_single">Delete this report?</string>
    <!-- Post-export Snackbar: %1$d = count exported, %2$s = file name. -->
    <string name="exported_snackbar">Exported %1$d reports to %2$s</string>
    <!-- Toast when there is nothing to export. -->
    <string name="toast_no_reports_to_export">No reports to export.</string>
    <!-- Shown in place of coordinates when a report has no GPS fix. -->
    <string name="indoor_marker">Indoor</string>

    <!-- Reports summary-header format templates. -->
    <!-- Total report count. %1$d = total. -->
    <string name="fmt_total_reports">Total reports: %1$d</string>
    <!-- Last detection relative time. %1$s = e.g. "2 minutes ago". -->
    <string name="fmt_last_detection">Last detection: %1$s</string>
    <!-- A single "LABEL: count" chunk used to build the breakdown lines. -->
    <string name="fmt_breakdown_chunk">%1$s: %2$d</string>
    <!-- Separator placed between breakdown chunks. -->
    <string name="breakdown_separator">  •  </string>

    <!-- Report row / detail field format templates. -->
    <!-- Row title line: "<class> · <Severity>". -->
    <string name="fmt_report_title">%1$s · %2$s</string>
    <!-- Row second line: confidence and bbox area. -->
    <string name="fmt_report_meta">conf %1$.2f · bbox %2$.1f%%</string>
    <!-- Row third line when GPS present: "lat, lon · time". -->
    <string name="fmt_report_location">%1$.4f, %2$.4f · %3$s</string>
    <!-- Row third line when indoor: "Indoor · time". -->
    <string name="fmt_report_location_indoor">%1$s · %2$s</string>
    <!-- Detail coordinate display: "lat, lon". -->
    <string name="fmt_coords">%1$.4f, %2$.4f</string>

    <!-- Detail screen field labels (label : value). -->
    <string name="detail_class">Class: %1$s</string>
    <string name="detail_severity">Severity: %1$s</string>
    <string name="detail_confidence">Confidence: %1$.4f</string>
    <string name="detail_bbox">Bounding box area: %1$.2f%%</string>
    <string name="detail_location">Location: %1$s</string>
    <string name="detail_accuracy">GPS accuracy: %1$.1f m</string>
    <string name="detail_heading">Heading: %1$.1f°</string>
    <string name="detail_time">Time: %1$s</string>
    <string name="detail_device">Device: %1$s</string>
    <string name="detail_uploaded">Uploaded: %1$s</string>
    <string name="detail_id">Report ID: %1$d</string>

</resources>
